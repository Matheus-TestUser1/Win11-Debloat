<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Win11 Debloat" Width="1180" Height="820" MinWidth="1020" MinHeight="740"
        WindowStartupLocation="CenterScreen" Background="#F4F7F9" FontFamily="Segoe UI" FontSize="14"
        Foreground="#17313D" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#17313D"/>
            <Setter Property="BorderBrush" Value="#D7E2E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="7" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#0F766E"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="12,9"/><Setter Property="BorderBrush" Value="#D7E2E8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/><Setter Property="BorderBrush" Value="#E1E9EE"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18"/></Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Background="#F4F7F9">
        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#112D39" Padding="20,28">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,30">
                    <Border Background="#1D4552" CornerRadius="10" Width="44" Height="44" HorizontalAlignment="Left" Margin="0,0,0,14">
                        <TextBlock Text="W" Foreground="#82E2CD" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Win11 Debloat" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Seu Windows, suas escolhas." Foreground="#ADC5CF" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="#1D4552" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                        <StackPanel><TextBlock Text="EXECUÇÃO LOCAL" Foreground="#82E2CD" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="Nenhum ajuste é aplicado ao abrir o programa." Foreground="#D4E2E8" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
                    </Border>
                    <TextBlock Text="v3.0 • PowerShell + WPF" Foreground="#ADC5CF" FontSize="11"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="CATEGORIAS" Foreground="#ADC5CF" FontSize="10" FontWeight="Bold" Margin="0,0,0,14"/>
                    <ListBox x:Name="CategoryList" Background="Transparent" BorderThickness="0" Foreground="White" SelectedIndex="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,11"/><Setter Property="Margin" Value="0,0,0,5"/>
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="NavBorder" CornerRadius="7" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#245362"/><Setter Property="Foreground" Value="#99F1DC"/></Trigger>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#1D4552"/></Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavBorder" Property="BorderBrush" Value="#82E2CD"/><Setter TargetName="NavBorder" Property="BorderThickness" Value="1"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate></Setter.Value></Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBoxItem Content="Todas as opções"/><ListBoxItem Content="Privacidade"/><ListBoxItem Content="Aplicativos"/>
                        <ListBoxItem Content="Serviços"/><ListBoxItem Content="Desempenho"/><ListBoxItem Content="Manutenção"/>
                    </ListBox>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="26,24,26,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,20">
                <StackPanel><TextBlock Text="Ajuste o Windows do seu jeito" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="Revise as opções, simule o resultado e aplique quando estiver pronto." Foreground="#58717F" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="15"><StackPanel><TextBlock Text="COMPUTADOR" Foreground="#58717F" FontSize="10"/><TextBlock x:Name="SystemLabel" Text="Clique em Analisar para identificar" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="15" Margin="10,0,0,0"><StackPanel><TextBlock Text="SELECIONADAS" Foreground="#58717F" FontSize="10"/><TextBlock x:Name="SelectionCount" Text="0 opções" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="15" Margin="10,0,0,0"><StackPanel><TextBlock Text="APLICATIVOS DO CATÁLOGO" Foreground="#58717F" FontSize="10"/><TextBlock x:Name="AppsCount" Text="Não analisado" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
            </Grid>
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
                <Grid Margin="0,0,16,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="SearchBox" ToolTip="Buscar opções pelo nome ou descrição" AutomationProperties.Name="Buscar opções"/>
                            <TextBlock Text="Buscar opções..." Foreground="#6B8390" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button x:Name="RecommendedButton" Grid.Column="1" Content="Perfil básico" Margin="8,0,0,0" ToolTip="Seleciona apenas diagnóstico opcional e sugestões"/>
                    </Grid>
                    <ListBox x:Name="ActionsList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate><DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="15">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="0,4,12,0" AutomationProperties.Name="{Binding Title}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Category}" Foreground="#0F766E" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" Margin="0,3,0,5" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Description}" Foreground="#58717F" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Availability}" Foreground="#0F766E" FontSize="11" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="Antes de aplicar" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Nenhum ajuste é selecionado ao abrir. O perfil básico marca dois ajustes de privacidade." Foreground="#58717F" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,15"/>
                            <TextBlock Text="SUA SELEÇÃO" FontSize="10" FontWeight="SemiBold" Foreground="#58717F"/>
                            <TextBlock x:Name="SummaryLabel" Text="Selecione as opções ao lado." TextWrapping="Wrap" FontSize="12" Margin="0,8,0,16"/>
                            <Separator Background="#E1E9EE" Margin="0,0,0,16"/>
                            <CheckBox x:Name="RestorePointCheck" IsChecked="True"><TextBlock Text="Criar ponto de restauração antes de aplicar" TextWrapping="Wrap" FontSize="12" Width="180"/></CheckBox>
                            <TextBlock Text="Se o Windows não conseguir criá-lo, a aplicação será interrompida. O backup de ajustes é salvo em toda execução." TextWrapping="Wrap" FontSize="11" Foreground="#58717F" Margin="0,10,0,16"/>
                            <Button x:Name="RestoreButton" Content="Restaurar último backup" Margin="0,0,0,8"/>
                            <Button x:Name="OpenLogsButton" Content="Abrir backups e registros" Margin="0,0,0,8"/>
                            <TextBlock Text="O backup restaura ajustes do registro, serviços e plano de energia. Apps removidos, arquivos excluídos e reparos do SFC não são desfeitos por ele." TextWrapping="Wrap" FontSize="11" Foreground="#58717F" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            <Border Grid.Row="3" Background="#112D39" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                <DockPanel><Grid DockPanel.Dock="Top" Margin="0,0,0,8"><TextBlock Text="REGISTRO DA EXECUÇÃO" Foreground="#ADC5CF" FontSize="10" FontWeight="Bold"/>
                    <Button x:Name="SaveLogButton" Content="Salvar registro" HorizontalAlignment="Right" Padding="8,2" FontSize="10" Margin="0" Background="#1D4552" Foreground="White" BorderThickness="0"/></Grid>
                    <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" Foreground="#D6E8EE" BorderThickness="0" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="0"/>
                </DockPanel>
            </Border>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,15,0"><TextBlock x:Name="StatusLabel" Text="Pronto. Nenhuma alteração aplicada." Foreground="#58717F" FontSize="12" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="WorkProgress" Height="4" Margin="0,7,0,0" Foreground="#0F766E" Background="#DCE8EB" BorderThickness="0" Minimum="0" Maximum="100"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ScanButton" Content="Analisar"/>
                    <Button x:Name="PreviewButton" Content="Simular"/>
                    <Button x:Name="ApplyButton" Content="Aplicar seleção" Background="#0F766E" Foreground="White" BorderBrush="#0F766E" Margin="0" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
